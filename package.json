{
  "name": "lunero",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "infra:up": "docker compose up -d --wait convex convex-dashboard redis minio && docker compose run --rm minio-init",
    "infra:down": "docker compose down",
    "dev": "bun scripts/dev.ts",
    "build": "bun run --filter 'web' build",
    "start": "bun run --filter 'web' start",
    "stripe:listen": "stripe listen --forward-to http://127.0.0.1:3211/stripe/webhook",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "env:sync": "bun scripts/sync-env.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.2"
  },
  "packageManager": "bun@1.3.14"
}
