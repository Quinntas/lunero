# ---------------------------------------------------------------------------
# Lunero configuration. `bun run setup` copies this file to `.env`.
# ---------------------------------------------------------------------------

# Fixed platform fee, in centavos, that Lunero keeps from every accepted draft.
# It is split across the milestones proportionally to their price and deducted
# from what the freelancer receives. 990 = R$ 9,90.
LUNERO_FEE_CENTS=990

# Public URL of the web app (Stripe redirects, Convex Auth).
SITE_URL=http://localhost:3000

# Convex (self-hosted via docker compose).
VITE_CONVEX_URL=http://127.0.0.1:3210
CONVEX_URL=http://127.0.0.1:3210

# Stripe (BRL, card + Pix). Use test keys from https://dashboard.stripe.com/test/apikeys
# The webhook secret is printed by `bun run stripe:listen`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Redis (rate limiting + signed URL cache on the web server).
REDIS_URL=redis://localhost:6379

# S3-compatible storage (MinIO locally).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lunero
S3_ACCESS_KEY_ID=lunero
S3_SECRET_ACCESS_KEY=lunero-secret
